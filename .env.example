# Non-secret values work as they are after `cp .env.example .env`.
# Fill in the empty ones; FERNET_KEY and AIRFLOW__API_AUTH__JWT_SECRET are required (see README).
# Do not leave a variable empty to get its default: an empty value overrides it.

# Application database, read by the application on the host (local development credentials).
# Inside the Airflow containers docker-compose.yaml overrides it to point at the pgvector service.
DATABASE_URL=postgres://root:root@localhost:5432/mechragnic
# Ollama base URL
OLLAMA_URL=http://localhost:11434
# Embedding model; must match the VECTOR(768) column
EMBEDDING_MODEL=nomic-embed-text
# Chat model, used for synthesis and the agent
CHAT_MODEL=qwen2.5:7b-instruct
# Stack Exchange API base URL
STACK_EXCHANGE_URL=https://api.stackexchange.com/2.3
# Stack Exchange API key, optional, raises the request quota
STACK_EXCHANGE_API_KEY=

# User ID that owns the files Airflow writes to the mounted directories (output of `id -u`)
AIRFLOW_UID=50000
# Airflow Fernet key, required by docker-compose.yaml
FERNET_KEY=
# Secret Airflow uses to sign API tokens, required by docker-compose.yaml
AIRFLOW__API_AUTH__JWT_SECRET=
