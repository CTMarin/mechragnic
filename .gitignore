# Secrets and local configuration (.env matches at any depth, airflow/.env included)
.env
.env.*
!.env.example
airflow/.env

# Airflow runtime files (generated by airflow-init and the scheduler)
airflow/logs/
airflow/config/airflow.cfg
airflow/plugins/

# Python
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/

# Web
web/node_modules/
web/dist/

# Editors and OS
.idea/
web/.idea/
.vscode/
.DS_Store
